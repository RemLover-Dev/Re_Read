# Re:Read (RemReader) Environment Configuration Template
# Zerochan Account Credentials (bypasses Cloudflare bot detection via gallery-dl)
# Create a free account at: https://www.zerochan.net/register
ZEROCHAN_LOGIN=your_zerochan_username
ZEROCHAN_PASSWORD=your_zerochan_password

# Optional HTTP / SOCKS5 Proxy for Booru scraping
VITE_HTTP_PROXY=
VITE_HTTPS_PROXY=

# Optional Booru / Zerochan User-Agent Override
VITE_CUSTOM_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Application Port
PORT=1420
